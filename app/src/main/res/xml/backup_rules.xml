<?xml version="1.0" encoding="utf-8"?>
<!--
    Belt and braces. allowBackup is already false in the manifest, so nothing
    here runs — but if it is ever turned back on, this makes sure that is a
    deliberate act rather than an accident that silently starts uploading a
    reader's subscriptions and reading history.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
