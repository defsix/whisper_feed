<?xml version="1.0" encoding="utf-8"?>
<!--
    What may travel, once the reader has agreed to it at all. Whether a backup
    happens is PlatformBackupAgent's decision; this is what is in it when it
    does.

    The two encrypted preference files never travel, on any route and whatever
    the reader chose. EncryptedSharedPreferences keeps its key in the
    hardware-backed Keystore, and the Keystore is not part of a backup — so a
    restored device would get the ciphertext without the key, and the first
    read would throw rather than return empty. That is a crash on launch for
    somebody who did the right thing and restored their phone. Signing in
    again is a far better outcome.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="whisper_account.xml" />
    <exclude domain="sharedpref" path="mastodon_tokens.xml" />
</full-backup-content>
