    <string name="mark_read_seconds_short">%1$.0fs</string>
    <string name="mark_read_never">Never — only when opened</string>
    <string name="mark_read_seconds">After %1$.1f seconds on screen, once scrolled past</string>
    <string name="pref_read_visibility">Articles you have read</string>
    <string name="pref_read_visibility_summary">A read article always loses weight and sinks. This is whether it also fades or goes.</string>
