    <string name="tour_chips_title">Categories</string>
    <string name="tour_chips_body">Everything at once, or one subject at a time. The launcher page follows whatever you choose here.</string>
    <string name="tour_article_title">Every article has a menu</string>
    <string name="tour_article_body">More like this, less like this, save it, or ask why an article is the size it is.</string>
    <string name="tour_bookmarks_title">Saved articles</string>
    <string name="tour_bookmarks_body">Anything you save is kept on your phone and stays readable offline.</string>
    <string name="tour_filter_title">Sort and filter</string>
    <string name="tour_filter_body">Change the order, mute a source, or hide what you have already read.</string>
    <string name="tour_overflow_title">Settings</string>
    <string name="tour_overflow_body">Your sources, the layout, what gets fetched in full, and what Whisper has learned about your reading. Reload and restart are at the top.</string>
