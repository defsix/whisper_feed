    <string name="learned_nudge">Weight: %1$+.2f</string>
    <string name="learned_forget">Forget this source\'s score</string>
    <string name="learned_unhide">Show this source again</string>
    <string name="learned_reset_all">Forget everything</string>
    <string name="covered_by_sources">Covered by %1$d sources</string>
    <string name="learned_reset_all_desc">Clears every More/Less score and shows any hidden sources again. Your subscriptions, saved articles and read history are not touched.</string>
    <string name="pref_mark_all_read">Mark everything as read</string>
    <string name="pref_mark_all_read_summary">Clears the unread count. The feed offers it back until you leave it.</string>
    <string name="pref_mark_read_on_scroll">Mark as read while scrolling</string>
    <string name="pref_mark_read_on_scroll_summary">How long an article has to stay on screen before it counts as read. Set it to what matches your own reading — a fling past a card gives it about half a second.</string>
    <string name="mark_read_never">Never — only when opened</string>
    <string name="mark_read_seconds">After %1$.1f seconds on screen</string>
    <string name="pref_read_visibility">Articles you have read</string>
    <string name="pref_read_visibility_summary">A read article always loses weight and sinks. This is whether it also fades or goes.</string>
    <string name="read_visibility_keep">Keep them</string>
    <string name="read_visibility_dim">Fade them</string>
    <string name="read_visibility_hide">Hide them</string>
    <string name="show_read_articles">Show articles you have read</string>
    <string name="pref_volume_key_scroll">Volume keys scroll the feed</string>
    <string name="pref_volume_key_scroll_summary">Volume down pages forward, volume up pages back. Only inside the app — the launcher keeps its own keys.</string>
    <string name="report_problem">Report a problem</string>
    <string name="report_problem_summary">Sends a report with your app version, device, settings and recent log. Describe what happened in the message itself.</string>
