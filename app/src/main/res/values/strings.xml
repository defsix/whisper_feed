    <string name="onboarding_welcome_title">Curate. Read. Breathe.</string>
    <string name="onboarding_welcome_body">A calmer, more focused way to follow the world.</string>
    <string name="onboarding_sources_title">Your sources, your choice</string>
    <string name="onboarding_sources_body">Add the sites you already read. No algorithm decides what you see, and nothing about your reading leaves your phone.</string>
    <string name="onboarding_calm_title">Read at your own pace</string>
    <string name="onboarding_calm_body">Whisper learns which sources you return to and gives them more room. Everything else stays out of the way.</string>
