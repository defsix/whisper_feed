    <string name="pref_breaking_news">Highlight breaking news</string>
    <string name="pref_breaking_news_summary">When several of your News sources cover the same story within a few hours, give it the largest card. Uses sources filed under a News category only.</string>
    <string name="why_breaking">Several sources are covering this story</string>
    <string name="pref_sticky_top">Hold it there while you scroll</string>
    <string name="pref_sticky_top_summary">A pinned article, or a breaking story, stays at the top of the screen until you have scrolled a few articles past it.</string>
    <string name="empty_bookmarks">Nothing saved yet</string>
    <string name="empty_bookmarks_hint">Tap the save mark on any article and it is kept here, readable offline.</string>
    <string name="empty_no_sources">No sources yet</string>
    <string name="empty_no_sources_hint">Add a website or a feed address and Whisper will do the rest. Settings, then Sources.</string>
    <string name="empty_syncing">Fetching your feeds</string>
    <string name="empty_syncing_hint">This is the first fetch, so it takes a moment longer than usual.</string>
    <string name="empty_nothing_fetched">Nothing came back</string>
    <string name="empty_nothing_fetched_hint">Your sources are set up but no articles arrived. Pull down to try again, or check Sources for a feed marked as failing.</string>
    <string name="empty_filtered">Nothing matches</string>
    <string name="empty_filtered_hint">Every article is filtered out by the category or filter you have chosen. Tap All, or open the filter to change it.</string>
    <string name="pref_backup">Back up your subscriptions</string>
    <string name="pref_backup_summary">All off until you turn something on. The only part of Whisper that can send your data anywhere.</string>
    <string name="backup_explanation">Your subscription list took a long time to build and exists only on this phone. Choose somewhere to keep a copy and Whisper will write it there once a day, over Wi-Fi.</string>
    <string name="backup_only_time">Nothing on this screen happens unless you ask for it.\n\nWhisper has no server and no account of its own, so this is the only part of the app that can send your data anywhere. Everything here is off until you turn it on: no folder is chosen, and Android\u2019s own backup hands over nothing. Turn on what suits you \u2014 and nothing else will leave this phone.</string>
    <string name="backup_off">Everything here is off. Nothing is leaving this phone.</string>
    <string name="pref_platform_device">Include in phone-to-phone transfer</string>
    <string name="pref_platform_device_summary">When you set up a new phone next to this one. A direct copy \u2014 no server involved.</string>
    <string name="pref_platform_cloud">Include in Google cloud backup</string>
    <string name="pref_platform_cloud_summary">Your feeds and reading history are kept in your Google account. Convenient, but it does leave the phone.</string>
    <string name="backup_platform_heading">Android\u2019s own backup</string>
    <string name="backup_platform_body">Android can carry apps to a new phone by itself. Whisper hands over nothing unless you switch it on here, and the two are asked separately because they are different things. Your sign-in tokens are never included either way \u2014 they cannot survive the trip, and restoring them would stop the app starting.</string>
    <string name="backup_choose">Choose where backups go</string>
    <string name="backup_change">Choose a different folder</string>
    <string name="backup_now">Back up now</string>
    <string name="backup_restore">Restore sources from a backup</string>
    <string name="backup_restore_settings">Restore your settings</string>
    <string name="backup_settings_restored">Restored %1$d settings</string>
    <string name="backup_none">No folder chosen yet</string>
    <string name="backup_never">Not backed up yet</string>
    <string name="backup_last">Last backed up %1$s</string>
    <string name="backup_written">Saved as %1$s</string>
    <string name="backup_restored">Added %1$d sources</string>
    <string name="backup_restored_none">Everything in that backup is already here</string>
    <string name="backup_lost">Whisper can no longer write to that folder. Choose it again.</string>
    <string name="backup_failed">That did not work</string>
    <string name="backup_what">Two files are saved: your sources and their categories as OPML, which any other reader can open, and your settings alongside it. No articles, and nothing about what you have read. Restoring sources adds them without removing anything; restoring settings replaces what you have, so it is a separate choice.</string>
    <string name="pref_account">Account</string>
    <string name="pref_account_summary">Optional. Keep your subscriptions and read state in step across devices.</string>
    <string name="account_explanation">Whisper works completely without an account — everything stays on this phone. Connecting one keeps your subscriptions and what you have read in step with another device, through a service you choose or run yourself.</string>
    <string name="account_server">Server address</string>
    <string name="account_username">Username</string>
    <string name="account_password">Password</string>
    <string name="account_password_hint">Most services offer an application password for this. Use one if yours does — it can be revoked without changing your real password.</string>
    <string name="account_sign_in">Sign in</string>
    <string name="account_sign_out">Sign out</string>
    <string name="account_sign_out_keeps">Signing out keeps your feeds and articles on this phone.</string>
    <string name="account_sync_now">Sync now</string>
    <string name="account_never_synced">Not synced yet</string>
    <string name="account_last_sync">Last synced %1$s</string>
    <string name="account_what_syncs">Works with FreshRSS, Miniflux, Inoreader and BazQux. Articles are still fetched from the feeds themselves, so Whisper keeps working when your server does not.</string>
    <string name="pref_learned">What Whisper has learned</string>
    <string name="pref_learned_summary">Every score the feed reads from your own behaviour, and the way to undo any of it.</string>
    <string name="learned_explanation">Nothing here is guessed. These are counts of what you have pressed and opened, and the effect each one has on how prominently a source appears. None of it leaves your phone.</string>
    <string name="learned_detail">More/Less score %1$d · %2$d read in 30 days</string>
    <string name="learned_nudge">Weight: %1$+.2f</string>
    <string name="learned_forget">Forget this source\'s score</string>
    <string name="learned_unhide">Show this source again</string>
    <string name="learned_reset_all">Forget everything</string>
    <string name="covered_by_sources">Covered by %1$d sources</string>
    <string name="learned_reset_all_desc">Clears every More/Less score and shows any hidden sources again. Your subscriptions, saved articles and read history are not touched.</string>
    <string name="pref_mark_all_read">Mark everything as read</string>
    <string name="pref_mark_all_read_summary">Clears the unread count. The feed offers it back until you leave it.</string>
    <string name="pref_mark_read_on_scroll">Mark as read while scrolling</string>
    <string name="pref_mark_read_on_scroll_summary">How long an article has to be on screen before scrolling past it counts as reading it. Nothing is marked while you are still looking at it. A fling past a card gives it about half a second.</string>
