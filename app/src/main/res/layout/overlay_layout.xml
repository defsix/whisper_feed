<!--
  The feed itself is now Compose (see FeedScaffold), so this is only the shell
  the overlay needs around it: overlay_root is what AbstractFloatingView anchors
  its bottom sheets and menus to, and feed_host is where the ComposeView goes in
  at runtime. The ComposeView is not declared here on purpose — composition
  starts on window attach, which during the overlay's setup happens inside
  upstream Java where a failure would take the whole feed down rather than just
  the content. See OverlayView.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/feed_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
